# URL base da API NestJS (inclui o prefixo /api).
# A API sobe na porta 3000 por padrão (ver ../api/.env).
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Firebase Remote Config — feature flags (projeto pontocontagem-eb570).
# Valores do app WEB registrado no console (Configurações do projeto → Seus
# apps → Web). Não são segredo (vão no bundle), mas ficam fora do repo.
# Sem eles as flags caem no default: tudo desligado.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pontocontagem-eb570.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pontocontagem-eb570
NEXT_PUBLIC_FIREBASE_APP_ID=
